<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kalkulator Alokasi Portofolio Kripto</title>
  <style>
    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #0f172a; color: #f8fafc; padding: 20px; display: flex; justify-content: center; }
    .card { background: #1e293b; padding: 24px; border-radius: 12px; width: 100%; max-width: 500px; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3); border: 1px solid #334155; }
    h2 { margin-top: 0; color: #38bdf8; text-align: center; font-size: 20px; }
    label { display: block; margin-top: 15px; font-weight: 600; font-size: 14px; color: #cbd5e1; }
    input, select { width: 100%; padding: 10px; margin-top: 6px; border-radius: 6px; border: 1px solid #475569; background: #0f172a; color: #fff; box-sizing: border-box; font-size: 14px; }
    button { width: 100%; margin-top: 20px; padding: 12px; border: none; border-radius: 6px; background: #0284c7; color: white; font-weight: bold; cursor: pointer; font-size: 15px; transition: background 0.2s; }
    button:hover { background: #0369a1; }
    .result { margin-top: 20px; border-top: 1px solid #334155; padding-top: 15px; }
    .item { display: flex; justify-content: space-between; margin-bottom: 10px; font-size: 14px; padding: 8px 0; border-bottom: 1px stroke #1e293b; }
    .badge { font-weight: bold; color: #38bdf8; }
    .desc { font-size: 12px; color: #94a3b8; margin-top: 2px; }
  </style>
</head>
<body>

  <div class="card">
    <h2>Kalkulator Portofolio Kripto</h2>
    
    <label>Total Modal Investasi (IDR):</label>
    <input type="number" id="capital" placeholder="Contoh: 10000000" value="10000000">
    
    <label>Profil Risiko & Strategi:</label>
    <select id="risk">
      <option value="conservative">Konservatif (Fokus BTC & ETH)</option>
      <option value="moderate" selected>Moderat (Seimbang / BTC-ETH + Top Altcoins)</option>
      <option value="aggressive">Agresif (Fokus Pertumbuhan & Altcoin)</option>
    </select>
    
    <button onclick="calculateAllocation()">Hitung Alokasi</button>
    
    <div class="result" id="output"></div>
  </div>

  <script>
    function formatIDR(num) {
      return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(num);
    }

    function calculateAllocation() {
      const capital = parseFloat(document.getElementById('capital').value);
      const risk = document.getElementById('risk').value;
      const output = document.getElementById('output');

      if (isNaN(capital) || capital <= 0) {
        output.innerHTML = '<p style="color: #ef4444;">Masukkan jumlah modal yang valid.</p>';
        return;
      }

      let alloc = [];
      if (risk === 'conservative') {
        alloc = [
          { name: 'Bitcoin (BTC)', pct: 55, desc: 'Aset fondasi utama & lindung nilai' },
          { name: 'Ethereum (ETH)', pct: 30, desc: 'Infrastruktur kontrak pintar' },
          { name: 'Top Altcoins (SOL, LINK, BNB)', pct: 10, desc: 'Proyek berkapitalisasi besar' },
          { name: 'Cash / Stablecoin (USDT/USDC)', pct: 5, desc: 'Cadangan beli saat koreksi' }
        ];
      } else if (risk === 'moderate') {
        alloc = [
          { name: 'Bitcoin (BTC)', pct: 40, desc: 'Penjaga stabilitas portofolio' },
          { name: 'Ethereum (ETH)', pct: 30, desc: 'Pertumbuhan jangka panjang' },
          { name: 'Top Altcoins (SOL, LINK, AVAX)', pct: 20, desc: 'Kapitalisasi besar potensi tinggi' },
          { name: 'Mid Cap / Narasi Baru', pct: 10, desc: 'Peluang imbal hasil tambahan' }
        ];
      } else {
        alloc = [
          { name: 'Bitcoin (BTC)', pct: 25, desc: 'Jangkar keamanan dasar' },
          { name: 'Ethereum (ETH)', pct: 25, desc: 'Infrastruktur utama' },
          { name: 'Top Altcoins (SOL, LINK, AVAX)', pct: 30, desc: 'Pendorong utama portofolio' },
          { name: 'Small/Mid Cap & Sektor Risiko Tinggi', pct: 20, desc: 'Potensi imbal hasil maksimal' }
        ];
      }

      let html = '<h3 style="font-size: 16px; color: #f1f5f9; margin-bottom: 12px;">Rincian Alokasi Modal:</h3>';
      alloc.forEach(item => {
        const amount = (capital * item.pct) / 100;
        html += `
          <div class="item">
            <div>
              <div><strong>${item.name}</strong> (${item.pct}%)</div>
              <div class="desc">${item.desc}</div>
            </div>
            <div class="badge">${formatIDR(amount)}</div>
          </div>
        `;
      });

      output.innerHTML = html;
    }

    calculateAllocation();
  </script>

</body>
</html>
